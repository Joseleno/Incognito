<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Metadados comuns a todos os pacotes publicados. Todos saem na mesma versão, gerada pela tag. -->

  <PropertyGroup>
    <IsPackable>true</IsPackable>

    <Authors>Joseleno</Authors>
    <Company>CodeProcess Solutions</Company>
    <Product>CodeProcess.Incognito</Product>
    <Copyright>Copyright (c) 2026 Joseleno</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Joseleno/Incognito</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Joseleno/Incognito</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icone.png</PackageIcon>
    <PackageTags>lgpd;anonimizacao;pseudonimizacao;mascaramento-de-dados;dados-de-teste;cpf;cnpj;nfe;brasil;efcore</PackageTags>

    <!-- SourceLink já vem no SDK; estas opções completam a depuração a partir do pacote. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../README.md" Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)../docs/assets/icone.png" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

</Project>
