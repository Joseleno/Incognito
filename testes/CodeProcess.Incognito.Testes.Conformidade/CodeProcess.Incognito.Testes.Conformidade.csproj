<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Suíte base de conformidade de dialeto: biblioteca herdada pelos testes de cada dialeto, sem testes próprios (as
    classes com teste são abstratas). Só a extensibilidade e as asserções do xUnit, nunca o xunit.v3, que faria dela um
    executável de teste.
  -->

  <PropertyGroup>
    <IsTestProject>false</IsTestProject>
    <OutputType>Library</OutputType>
    <!-- Implementa e testa o contrato experimental de dialeto. -->
    <NoWarn>$(NoWarn);INCX001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CodeProcess.Incognito.Motor\CodeProcess.Incognito.Motor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.extensibility.core" />
    <PackageReference Include="xunit.v3.assert" />
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
