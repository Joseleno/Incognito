<Project Sdk="Microsoft.NET.Sdk">

  <!-- Só testes de banco (Categoria=Integracao), que o CI sem Docker filtra: lá este projeto roda zero testes. -->
  <PropertyGroup>
    <TestingPlatformCommandLineArguments>$(TestingPlatformCommandLineArguments) --ignore-exit-code 8</TestingPlatformCommandLineArguments>
    <!-- Implementa e testa o contrato experimental de dialeto. -->
    <NoWarn>$(NoWarn);INCX001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CodeProcess.Incognito.PostgreSql\CodeProcess.Incognito.PostgreSql.csproj" />
    <ProjectReference Include="..\CodeProcess.Incognito.Testes.Conformidade\CodeProcess.Incognito.Testes.Conformidade.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Testcontainers.PostgreSql" />
  </ItemGroup>

  <!-- O esquema de conformidade, a posse do destino com a guarda dela e as imagens fixadas por digest (uma pasta por versão, atualizadas pelo Dependabot). -->
  <ItemGroup>
    <EmbeddedResource Include="esquema-de-conformidade.sql" LogicalName="esquema-de-conformidade.sql" />
    <EmbeddedResource Include="posse-do-destino.sql" LogicalName="posse-do-destino.sql" />
    <EmbeddedResource Include="guarda-de-posse.sql" LogicalName="guarda-de-posse.sql" />
    <EmbeddedResource Include="presenca-do-sentinela.sql" LogicalName="presenca-do-sentinela.sql" />
    <EmbeddedResource Include="estado-dos-objetos.sql" LogicalName="estado-dos-objetos.sql" />
    <EmbeddedResource Include="diario-de-conformidade.sql" LogicalName="diario-de-conformidade.sql" />
    <None Include="imagens\*\Dockerfile" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
