<Project Sdk="Microsoft.NET.Sdk">

  <!-- Testa o contrato experimental de dialeto e roda a suíte de conformidade contra um dialeto falso. -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);INCX001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CodeProcess.Incognito.Motor\CodeProcess.Incognito.Motor.csproj" />
    <ProjectReference Include="..\CodeProcess.Incognito.Testes.Conformidade\CodeProcess.Incognito.Testes.Conformidade.csproj" />
  </ItemGroup>

  <!-- Testes de propriedade (CsCheck) e o JSON Schema validado por um motor completo de draft-07 (só aqui). -->
  <ItemGroup>
    <PackageReference Include="CsCheck" />
    <PackageReference Include="Corvus.Json.Validator" />
  </ItemGroup>

  <!-- O esquema publicado e o vetor fixo do hash da configuração, lidos da pasta de saída. -->
  <ItemGroup>
    <None Include="..\..\esquema\incognito.schema.json" Link="esquema\incognito.schema.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\vetores\hash-configuracao@1.json" Link="vetores\hash-configuracao@1.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
