{
  "stryker-config": {
    "project": "CodeProcess.Incognito.csproj",
    "test-runner": "mtp",
    "coverage-analysis": "perTest",
    "concurrency": 4,
    "break-on-initial-test-failure": true,
    "timeout-ratio": 2,
    "additional-timeout": 10000,
    "ignore-methods": ["*Exception.ctor"],
    "thresholds": {
      "high": 90,
      "low": 80,
      "break": 80
    },
    "reporters": ["progress", "html", "json", "markdown"]
  }
}
