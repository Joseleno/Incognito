<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\src\CodeProcess.Incognito\CodeProcess.Incognito.csproj" />
  </ItemGroup>

  <!-- Testes de propriedade com geração e redução automáticas; só neste projeto. -->
  <ItemGroup>
    <PackageReference Include="CsCheck" />
  </ItemGroup>

  <!-- Âncoras independentes e vetores fixos, lidos da pasta de saída. -->
  <ItemGroup>
    <None Include="..\ancoras\**\*.json" LinkBase="ancoras" CopyToOutputDirectory="PreserveNewest" />
    <!-- A pasta inteira: uma sobra que não seja .json também chega ao teste da pasta e é acusada. -->
    <None Include="..\vetores\**\*" LinkBase="vetores" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
