<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!--
    Benchmarks (BenchmarkDotNet): solução própria (Incognito.Benchmarks.slnx), fora da solução principal, do release e
    dos testes; nunca viram pacote. Rodam só em Release.
  -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

</Project>
