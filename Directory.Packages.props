<Project>

  <!-- Central Package Management: toda versão de pacote é declarada aqui, nunca no .csproj. -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- Analisadores -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
  </ItemGroup>

  <!-- Empacotamento -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Sbom.Targets" Version="4.1.13" />
    <PackageVersion Include="MinVer" Version="8.0.0" />
  </ItemGroup>

  <!-- Motor -->
  <ItemGroup>
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <!-- Benchmarks (solução própria em benchmarks/) -->
  <ItemGroup>
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <!--
    Testes. O xUnit numa versão só: o xunit.v3 nos projetos de teste e, na suíte de conformidade (biblioteca, sem
    executável), o xunit.v3.extensibility.core e o xunit.v3.assert, que ele também traz.
  -->
  <PropertyGroup>
    <VersaoXunit>4.0.2</VersaoXunit>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="coverlet.MTP" Version="10.1.0" />
    <PackageVersion Include="Corvus.Json.Validator" Version="5.7.6" />
    <PackageVersion Include="CsCheck" Version="4.9.1" />
    <PackageVersion Include="xunit.v3" Version="$(VersaoXunit)" />
    <PackageVersion Include="xunit.v3.assert" Version="$(VersaoXunit)" />
    <PackageVersion Include="xunit.v3.extensibility.core" Version="$(VersaoXunit)" />
  </ItemGroup>

</Project>
